# Copy this file to .env and fill in your keys. NEVER commit .env.
# Nebius Token Factory (required)
NEBIUS_API_KEY=your-nebius-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# The NVIDIA open-source model ID from the Nebius Model catalog (REQUIRED for eligibility).
# NVIDIA Nemotron model (Public serverless endpoint, us-central1):
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Tavily (optional but recommended — qualifies for the "Best Use of Tavily" $3k prize)
TAVILY_API_KEY=your-tavily-key-here
